# GoodScore Voice Service — environment configuration
# Copy to .env for local development. In ECS, set these as task definition
# environment variables / Secrets Manager references — never bake real
# values into the image.

# --- Server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8090

# --- OpenRouter (STT + TTS) ---------------------------------------------
# Get an API key at https://openrouter.ai — store it in Secrets Manager in
# ECS, referenced by the task definition's `secrets` block, not plain env.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=REPLACE_ME

# Confirmed live on OpenRouter as of this integration (see README for how
# this was verified). If OpenRouter stops serving either model, the
# adapters will surface the provider's error rather than silently
# switching models — update these to the current slug instead.
OPENROUTER_STT_MODEL=nvidia/nemotron-3.5-asr-streaming-multilingual-0.6b
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
# Kokoro requires an explicit voice (confirmed against the live API — it
# 400s with "An explicit voice is required for this TTS provider" if this
# is empty). af_heart is Kokoro's documented default English voice; Hindi
# voices exist too (hf_alpha, hf_beta, hm_omega, hm_psi) if you want to
# experiment with a Hindi-specific voice for hi/hi-en calls — Phase 1 uses
# one fixed voice regardless of detected language (see README TBD notes).
OPENROUTER_TTS_VOICE=af_heart
OPENROUTER_TTS_RESPONSE_FORMAT=pcm

OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_MAX_RETRIES=2

# --- Existing GoodScore chatbot (Strands + AgentCore) -------------------
# "local"     — call a locally running backend/server.py directly (dev).
# "agentcore" — SigV4-sign requests to the AgentCore Runtime invoke URL
#               using the ECS task's own IAM role.
CHATBOT_MODE=local
CHATBOT_LOCAL_BASE_URL=http://localhost:8000

# TBD — the production AgentCore Runtime invoke URL for this chatbot
# (same shape as AGENTCORE_URL in backend/lambda_sts_function.py). Required
# only when CHATBOT_MODE=agentcore.
AGENTCORE_INVOKE_URL=

AWS_REGION=ap-south-1
CHATBOT_TIMEOUT_SECONDS=45
CHATBOT_CONNECT_TIMEOUT_SECONDS=5

# --- GoodScore backend API (credit-report prefetch) ----------------------
GOODSCORE_API_BASE_URL=https://subscription.stage.goodscore.io
GOODSCORE_API_TIMEOUT_SECONDS=15
GOODSCORE_API_MAX_RETRIES=3

# --- Audio ----------------------------------------------------------------
VOICE_AUDIO_INPUT_FORMAT=webm
VOICE_AUDIO_OUTPUT_FORMAT=pcm
VOICE_AUDIO_SAMPLE_RATE_HZ=16000

# --- Fillers ----------------------------------------------------------------
FILLER_MIN_WAIT_SECONDS=1.2
FILLER_REPEAT_COOLDOWN_SECONDS=8

# --- Token usage export -----------------------------------------------------
# One text file per turn's LLM call (voice channel only — chat is
# unaffected). Relative paths resolve against the working directory the
# service was started from. Gitignored.
TOKEN_USAGE_LOG_DIR=token_usage_logs

# --- Call / session lifecycle ----------------------------------------------
CALL_TTL_SECONDS=1800
SESSION_SWEEP_INTERVAL_SECONDS=30
MAX_CONCURRENT_CALLS=200

# --- Language (Phase 1: English, Hindi, Hinglish) ---------------------------
VOICE_SUPPORTED_LANGUAGES=en,hi,hi-en
VOICE_DEFAULT_LANGUAGE=hi-en
# "explicit"  — mobile app always sends hello.language.
# "auto_stt"  — let the STT provider auto-detect (hello.language omitted).
# TBD: final product decision — see README.
VOICE_LANGUAGE_SELECTION_MODE=auto_stt
